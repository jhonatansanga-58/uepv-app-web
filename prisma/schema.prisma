generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  TUTOR
  STUDENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                  Int            @id @default(autoincrement())
  firstName           String
  lastName            String
  userName            String         @unique
  email               String         @unique
  password            String
  role                Role           @default(STUDENT)
  phone               String?
  address             String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  active              Boolean        @default(true)
  studentProfile      Student?       @relation("UserStudent")
  tutorships          StudentTutor[]
  attendancesRecorded Attendance[]
  meetingsAsTeacher   Meeting[]      @relation("TeacherMeeting")
  notifications       Notification[]

  TeacherSubject TeacherSubject[]
  LeaveRequest   LeaveRequest[]
}

model Student {
  id               Int            @id
  user             User           @relation("UserStudent", fields: [id], references: [id])
  birthDate        DateTime?
  gender           Gender?
  cardCode         String         @unique
  courseParallelId Int
  courseParallel   CourseParallel @relation(fields: [courseParallelId], references: [id])
  tutorships       StudentTutor[]
  meetings         Meeting[]      @relation("StudentMeeting")
  attendances      Attendance[]
  leaveRequests    LeaveRequest[]
}

model StudentTutor {
  id        Int     @id @default(autoincrement())
  studentId Int
  tutorId   Int
  student   Student @relation(fields: [studentId], references: [id])
  tutor     User    @relation(fields: [tutorId], references: [id])
}

model Course {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  active    Boolean          @default(true)
  parallels CourseParallel[]

  CourseSubject CourseSubject[]
}

model Parallel {
  id      Int              @id @default(autoincrement())
  name    String           @unique
  courses CourseParallel[]
}

model CourseParallel {
  id            Int            @id @default(autoincrement())
  courseId      Int
  parallelId    Int
  active        Boolean        @default(true)
  course        Course         @relation(fields: [courseId], references: [id])
  parallel      Parallel       @relation(fields: [parallelId], references: [id])
  students      Student[]
  tasks         Task[]         @relation("CourseParallelTasks")
  notifications Notification[]
}

model Subject {
  id       Int              @id @default(autoincrement())
  name     String           @unique
  active   Boolean          @default(true)
  teachers TeacherSubject[]
  courses  CourseSubject[]
  tasks    Task[]
}

model TeacherSubject {
  id        Int     @id @default(autoincrement())
  teacherId Int
  subjectId Int
  teacher   User    @relation(fields: [teacherId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@unique([teacherId, subjectId])
}

model CourseSubject {
  id        Int     @id @default(autoincrement())
  courseId  Int
  subjectId Int
  course    Course  @relation(fields: [courseId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@unique([courseId, subjectId])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  userId    Int?
  date      DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
}

model LeaveRequest {
  id              Int         @id @default(autoincrement())
  studentId       Int
  tutorId         Int
  title           String
  message         String
  reason          String
  startDate       DateTime?
  endDate         DateTime?
  requestDate     DateTime    @default(now())
  status          LeaveStatus @default(PENDING)
  active          Boolean     @default(true) // para habilitar/deshabilitar
  rejectionReason String?
  updatedAt       DateTime    @updatedAt
  student         Student     @relation(fields: [studentId], references: [id])
  tutor           User        @relation(fields: [tutorId], references: [id])
}

model Task {
  id               Int            @id @default(autoincrement())
  subjectId        Int
  courseParallelId Int
  title            String
  description      String
  sendDate         DateTime       @default(now())
  dueDate          DateTime
  active           Boolean        @default(true)
  courseParallel   CourseParallel @relation("CourseParallelTasks", fields: [courseParallelId], references: [id])
  subject          Subject        @relation(fields: [subjectId], references: [id])
}

model Meeting {
  id        Int      @id @default(autoincrement())
  userId    Int
  studentId Int
  topic     String
  message   String
  date      DateTime @default(now())
  active    Boolean  @default(true)
  user      User     @relation("TeacherMeeting", fields: [userId], references: [id])
  student   Student  @relation("StudentMeeting", fields: [studentId], references: [id])
}

model Notification {
  id               Int             @id @default(autoincrement())
  title            String
  message          String
  date             DateTime        @default(now())
  userId           Int?
  courseParallelId Int?
  active           Boolean         @default(true)
  creatorId        Int
  user             User?           @relation(fields: [userId], references: [id])
  courseParallel   CourseParallel? @relation(fields: [courseParallelId], references: [id])
}
